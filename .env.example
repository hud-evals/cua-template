# HUD API key — used inside the container for LLM-judge grading via the HUD Gateway.
HUD_API_KEY=your-key-here

# Anthropic API key — for the computer-use agent. Computer-use is a provider-native beta: route
# through a beta-forwarding HUD gateway (HUD_API_KEY) for platform traces, or set this key and run
# with HUD_API_KEY="" to call Anthropic directly (see the README's routing note).
ANTHROPIC_API_KEY=
