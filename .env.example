# HUD API key — used inside the container for LLM-judge grading via the HUD Gateway.
HUD_API_KEY=your-key-here

# Anthropic API key — for the computer-use agent. Computer-use is a provider-native beta the
# HUD gateway does not forward, so the agent must call Anthropic directly (see the README:
# run with HUD_API_KEY="" so the SDK uses this key instead of the gateway).
ANTHROPIC_API_KEY=
